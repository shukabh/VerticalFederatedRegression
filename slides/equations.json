 "scale": {
  "color": "14213D",
  "tex": "\\log_2 \\Omega \\;\\approx\\; \\underbrace{\\kappa}_{40} + \\underbrace{\\log_2 B_{\\mathrm{tot}}}_{25.3} + \\underbrace{\\log_2\\!\\sqrt{N/2}}_{6.5} - \\underbrace{\\log_2\\!\\sqrt{2\\pi}}_{1.3} - \\underbrace{\\log_2 \\sigma_2}_{9.0} \\;\\approx\\; 61.5"
 },
 "c_rho": {
  "color": "14213D",
  "tex": "\\begin{aligned} &\\text{tight conversion of } (\\varepsilon, \\delta) \\\\ &\\sqrt{\\rho_{\\mathrm{run}}} \\gtrsim \\sqrt{L+\\varepsilon} - \\sqrt{L} \\end{aligned}"
 },
 "c_sigma": {
  "color": "14213D",
  "tex": "\\begin{aligned} \\sigma_1 &= \\Delta_G / \\sqrt{2 f_1 \\rho_{\\mathrm{run}}} \\\\ \\sigma_2 &= \\Delta / \\sqrt{2 (1 - f_1) \\rho_{\\mathrm{run}}} \\end{aligned}"
 },
 "c_lambda": {
  "color": "14213D",
