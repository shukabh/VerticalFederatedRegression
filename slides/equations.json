 },
 "w_K": {
  "color": "14213D",
  "tex": "K(\\theta)_{ii} = \\sum\\nolimits_j \\chi_{ij}\\,\\theta_j^2, \\qquad K(\\theta)_{ik} = \\chi_{ik}\\,\\theta_i\\theta_k \\ \\ (i \\ne k)"
 },
 "w_ci": {
  "color": "14213D",
