  "tex": "\\tilde\\theta_j \\;\\pm\\; z_{1-\\alpha/2}\\,\\sqrt{(V_{\\mathrm{mech}})_{jj}}"
 },
 "ci_beta": {
  "color": "14213D",
  "tex": "\\tilde\\theta_j \\;\\pm\\; \\mathrm{cv}_\\alpha\\!\\bigl(\\bar b_j / \\sqrt{V_{jj}}\\bigr)\\sqrt{V_{jj}}, \\qquad \\bar b_j = \\lambda\\,\\lVert \\Psi\\tilde P e_j \\rVert\\, \\hat B_\\beta"
 },
 "smudge": {
  "color": "14213D",
  "tex": "\\mathrm{SD}(\\eta + e,\\ \\eta) \\;\\le\\; \\frac{\\lVert e \\rVert_2}{\\sqrt{2\\pi}\\,\\sigma_c} \\;\\le\\; 2^{-\\kappa} \\quad\\text{if}\\quad \\sigma_c \\ge \\frac{2^{\\kappa} B_{\\mathrm{tot}}}{\\sqrt{2\\pi}}"
 },
 "sigma_slot": {
