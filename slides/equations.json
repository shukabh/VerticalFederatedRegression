 },
 "cal_lambda": {
  "color": "14213D",
  "tex": "\\begin{aligned} \\lambda = \\max\\{&0, \\\\ &2\\rho^{*}\\sigma\\sqrt{p} - n\\ell\\} \\end{aligned}"
 },
 "planning": {
