 },
 "w_boot": {
  "color": "14213D",
  "tex": "\\begin{aligned} \\mathbf E^*_b &= \\mathbf E^{*\\top}_b,\\quad E^*_{b,ij} \\sim \\mathcal N(0,\\sigma_2^2) \\text{ on } B, C;\\ 0 \\text{ on } A \\\\ \\mathbf f^*_b &\\sim \\mathcal N(0,\\ \\sigma_2^2 I_p) \\\\ \\theta^*_b &= \\bigl(\\hat G_2 + \\mathbf E^*_b + \\lambda\\Psi\\bigr)^{-1}\\bigl(\\hat c_2 + \\mathbf f^*_b\\bigr) \\end{aligned}"
 },
 "w_vmech": {
  "color": "14213D",
  "tex": "V_{\\mathrm{mech}} = \\frac{1}{B-1}\\sum_{b=1}^{B}\\bigl(\\theta^*_b - \\bar\\theta^*\\bigr)\\bigl(\\theta^*_b - \\bar\\theta^*\\bigr)^{\\!\\top}"
 },
 "w_trunc": {
  "color": "14213D",
  "tex": "\\text{keep } b \\text{ only if } \\bigl\\lVert \\tilde P^{1/2}\\,\\mathbf E^*_b\\,\\tilde P^{1/2} \\bigr\\rVert_{\\mathrm{op}} \\le \\tfrac12"
 },
 "w_fo": {
  "color": "14213D",
