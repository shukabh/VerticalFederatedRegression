  "tex": "\\Pr[\\mathcal{M}(D) \\in S] \\;\\le\\; e^{\\varepsilon}\\,\\Pr[\\mathcal{M}(D') \\in S] + \\delta"
 },
 "gauss": {
  "color": "14213D",
  "tex": "\\mathcal{M}(D) = f(D) + \\mathcal{N}(0, \\sigma^2 I), \\qquad \\sigma = \\Delta \\cdot s(\\varepsilon, \\delta)"
