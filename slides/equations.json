{
 "ols": {
  "color": "14213D",
  "tex": "\\hat\\beta = (Z^\\top Z)^{-1} Z^\\top y, \\qquad Z = \\bigl[\\, X_R^{I} \\;\\big|\\; X_O^{I} \\,\\bigr]"
 },
 "agg": {
  "color": "14213D",
  "tex": "\\begin{aligned} \\mathrm{Enc}(B_{jk}) &= \\sum\\nolimits_i \\mathrm{Enc}(b_i)\\, X_{O,ij}\\, X_{O,ik} \\\\ \\mathrm{Enc}(C_{jk}) &= \\sum\\nolimits_i \\mathrm{Enc}(\\dot X_{R,ij})\\, X_{O,ik} \\\\ \\mathrm{Enc}(c_{O,k}) &= \\sum\\nolimits_i \\mathrm{Enc}(b_i)\\, X_{O,ik}\\, y_i \\\\ \\mathrm{Enc}(c_{R,j}) &= \\sum\\nolimits_i \\mathrm{Enc}(\\dot X_{R,ij})\\, y_i \\end{aligned}"
 },
 "ridge": {
  "color": "14213D",
  "tex": "\\lambda = \\max\\{\\,0,\\; 2\\rho^{*}\\sigma\\sqrt{p} - n\\ell\\,\\}, \\qquad \\Psi = I"
 },
 "gate": {
  "color": "14213D",
  "tex": "\\hat\\rho = \\lambda_{\\min}(\\tilde G + \\lambda I)\\,/\\,(2\\sigma\\sqrt{p}) \\;\\ge\\; 1"
 },
 "ridge_est": {
  "color": "14213D",
  "tex": "\\tilde\\beta_\\lambda = (\\tilde G + \\lambda I)^{-1}\\,\\tilde c"
 },
 "bc": {
