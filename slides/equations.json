  "tex": "s = s_R + s_O: \\qquad c_0 + c_1 s \\;=\\; \\underbrace{(c_0 + c_1 s_O)}_{\\text{needs } \\mathsf{O}} \\;+\\; \\underbrace{c_1 s_R}_{\\text{needs } \\mathsf{R}}"
 },
 "upload": {
  "color": "14213D",
  "tex": "\\mathsf{R}:\\ \\ c_0 = -a\\,s_R + e + \\mathrm{Ecd}(v),\\ \\ a = \\mathrm{PRG}(\\mathrm{seed}) \\qquad\\quad \\mathsf{O}:\\ \\ c_0 \\leftarrow c_0 - a\\,s_O"
 },
 "release": {
  "color": "14213D",
  "tex": "\\begin{aligned} \\mathsf{O}:\\quad & c_0' = c_0 + p_0 u + e_0, \\qquad c_1' = c_1 + a u + e_1 \\\\ & h_O = c_0' + c_1' s_O + \\eta, \\qquad \\eta \\sim \\mathcal{N}_{\\mathbb{Z}}(0, \\sigma_c^2)^N \\\\ & \\text{send } (c_1',\\, h_O) \\\\ \\mathsf{R}:\\quad & v = h_O + c_1' s_R = \\mathrm{Ecd}(z) + e + \\eta \\end{aligned}"
 },
 "lam_rule": {
  "color": "14213D",
  "tex": "\\lambda = \\max\\{0,\\; 2\\vartheta^\\star\\sigma_2\\sqrt{p} + r_1 - \\lambda_{\\min}(\\hat G_1)\\}, \\qquad r_1 = \\sigma_1\\bigl(2\\sqrt{p} + 2\\sqrt{\\ln(1/\\alpha_L)}\\bigr)"
 },
 "estimate": {
  "color": "14213D",
  "tex": "\\tilde\\theta = (\\hat G_2 + \\lambda\\Psi)^{-1}\\hat c_2, \\qquad \\hat\\vartheta = \\frac{\\lambda_{\\min}(\\hat G_2 + \\lambda\\Psi)}{2\\sigma_2\\sqrt{p}} \\;\\ge\\; 1"
 },
 "estimands": {
